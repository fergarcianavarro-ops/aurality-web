# aurality · cabeceras de Cloudflare Pages (no hace falta tocarlo)

# contenido siempre fresco, para que lo que se guarda en el panel se vea al momento
/contenido/*
  Cache-Control: no-cache

# el panel privado no aparece en buscadores
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# imágenes con caché
/img/*
  Cache-Control: public, max-age=604800
/covers/*
  Cache-Control: public, max-age=86400
/senal/*
  Cache-Control: public, max-age=86400

# frecuencias ocultas: las sirve el portero (worker/), nunca desde caché
/tx/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# el programa lleva una huella en el nombre (cambia si cambia el código) y las tipografías no cambian: caché de un año
/js/*
  Cache-Control: public, max-age=31536000, immutable
/fuentes/*
  Cache-Control: public, max-age=31536000, immutable

# fragmentos de audio del catálogo (canal 00) y adelantos
/fragmentos/*
  Cache-Control: public, max-age=86400
