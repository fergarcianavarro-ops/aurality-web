// aurality · configuración de Cloudflare (Workers con archivos estáticos). No hace falta tocarla.
// Publica solo la carpeta web/; las cabeceras de caché están en web/_headers.
// worker/index.js solo atiende las páginas (no las imágenes ni el contenido) para poner la vista previa de cada enlace.
{
  "name": "aurality-web",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/*.*", "!/admin/*", "!/contenido/*", "!/covers/*", "!/senal/*", "!/img/*"]
  }
}
